<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Plain net8.0 (not -windows): the parser is UI-free and settings-free, so the tests
         need no WPF/WinForms and run cross-platform on the SDK. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClaudeUsageMonitor.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Link the real production source instead of a project reference, so we
       exercise the shipping logic without dragging in the net8.0-windows app. -->
  <ItemGroup>
    <Compile Include="..\..\Services\OpenRouterActivity.cs" />
  </ItemGroup>

</Project>
