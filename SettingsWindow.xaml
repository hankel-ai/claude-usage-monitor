<Window x:Class="ClaudeUsageMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage Monitor - Settings"
        Width="480" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Polling Settings -->
        <GroupBox Grid.Row="0" Header="Polling Interval" Margin="0,0,0,12"
                  Foreground="#CCC" BorderBrush="#444">
            <StackPanel Margin="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="IntervalSlider"
                            Minimum="30" Maximum="1800"
                            Value="120"
                            TickFrequency="30"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="IntervalSlider_ValueChanged"/>
                    <TextBlock x:Name="IntervalLabel" Grid.Column="1"
                               Foreground="#EEE" FontSize="13" FontWeight="SemiBold"
                               Width="80" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock Text="How often to fetch usage data from api.anthropic.com"
                           Foreground="#777" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Credentials Status -->
        <GroupBox Grid.Row="1" Header="Claude Code Credentials" Margin="0,0,0,12"
                  Foreground="#CCC" BorderBrush="#444">
            <StackPanel Margin="10,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse x:Name="AuthStatusDot" Width="10" Height="10" Margin="0,0,8,0"/>
                    <TextBlock x:Name="AuthStatusLabel" Foreground="#AAA" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="CredPathLabel" Foreground="#555" FontSize="10.5"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Foreground="#666" FontSize="10.5" TextWrapping="Wrap"
                           Text="Token is read from Claude Code's credentials file. If missing, run 'claude' in a terminal and log in."/>
            </StackPanel>
        </GroupBox>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Padding="20,7" Margin="0,0,8,0"
                    Click="Save_Click" IsDefault="True"
                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                    FontSize="12" Cursor="Hand"/>
            <Button Content="Cancel" Padding="20,7"
                    Click="Cancel_Click" IsCancel="True"
                    Background="#333" Foreground="#CCC" BorderBrush="#555"
                    FontSize="12" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
