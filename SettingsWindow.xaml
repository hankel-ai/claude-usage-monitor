<Window x:Class="ClaudeUsageMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage Monitor - Settings"
        Width="480" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Settings" Margin="0,0,0,12"
                  Foreground="#CCC" BorderBrush="#444">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,8">

                <!-- Launch on Windows startup -->
                <CheckBox x:Name="StartupCheckBox" Content="Launch on Windows startup"
                          Foreground="#CCC" FontSize="12"/>
                <TextBlock Foreground="#666" FontSize="10.5" Margin="0,4,0,0"
                           Text="Adds to HKCU\...\Run registry key (no admin required). Only works with the published .exe."/>

                <!-- Polling Interval -->
                <TextBlock Text="Polling interval" Foreground="#CCC" FontSize="12"
                           Margin="0,16,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="IntervalSlider"
                            Minimum="30" Maximum="1800"
                            Value="120"
                            TickFrequency="30"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="IntervalSlider_ValueChanged"/>
                    <TextBlock x:Name="IntervalLabel" Grid.Column="1"
                               Foreground="#EEE" FontSize="13" FontWeight="SemiBold"
                               Width="80" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock Text="How often to fetch usage data from api.anthropic.com"
                           Foreground="#777" FontSize="11" Margin="0,4,0,0"/>

                <!-- Hover Zoom Delay -->
                <TextBlock Text="Hover zoom delay" Foreground="#CCC" FontSize="12"
                           Margin="0,16,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="HoverDelaySlider"
                            Minimum="0" Maximum="2000"
                            Value="300"
                            TickFrequency="100"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="HoverDelaySlider_ValueChanged"/>
                    <TextBlock x:Name="HoverDelayLabel" Grid.Column="1"
                               Foreground="#EEE" FontSize="13" FontWeight="SemiBold"
                               Width="80" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock Text="Delay before magnifying on hover (0 = instant)"
                           Foreground="#777" FontSize="11" Margin="0,4,0,0"/>

                <!-- Credentials Status -->
                <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="AuthStatusDot" Width="10" Height="10" Margin="0,0,8,0"/>
                            <TextBlock x:Name="AuthStatusLabel" Foreground="#AAA" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="CredPathLabel" Foreground="#555" FontSize="10.5"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Foreground="#666" FontSize="10.5" TextWrapping="Wrap"
                                   Text="Token is read from Claude Code's credentials file. If missing, run 'claude' in a terminal and log in."/>
                    </StackPanel>
                </Border>

                <!-- LiteLLM Vertex Spend -->
                <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="LiteLLM Vertex Spend" Foreground="#CCC" FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="API key (admin / master key)" Foreground="#CCC" FontSize="12"
                                   Margin="0,10,0,4"/>
                        <PasswordBox x:Name="LiteLLMKeyBox" FontSize="12" Padding="4,3"
                                     Background="#2A2A2A" Foreground="#EEE" BorderBrush="#555"/>
                        <TextBlock Text="Used to read Total Spend from the LiteLLM proxy. Stored in settings.json."
                                   Foreground="#777" FontSize="10.5" Margin="0,4,0,0"/>

                        <TextBlock Text="Base URL" Foreground="#CCC" FontSize="12"
                                   Margin="0,12,0,4"/>
                        <TextBox x:Name="LiteLLMBaseUrlBox" FontSize="12" Padding="4,3"
                                 Background="#2A2A2A" Foreground="#EEE" BorderBrush="#555"/>

                        <TextBlock Text="Monthly budget (USD)" Foreground="#CCC" FontSize="12"
                                   Margin="0,12,0,4"/>
                        <TextBox x:Name="LiteLLMBudgetBox" FontSize="12" Padding="4,3" Width="120"
                                 HorizontalAlignment="Left"
                                 Background="#2A2A2A" Foreground="#EEE" BorderBrush="#555"/>
                        <TextBlock Text="The spend bar fills toward this budget (turns orange at 70%, red at 90%)."
                                   Foreground="#777" FontSize="10.5" Margin="0,4,0,0"/>

                        <TextBlock Text="Spend polling interval" Foreground="#CCC" FontSize="12"
                                   Margin="0,12,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SpendIntervalSlider"
                                    Minimum="60" Maximum="3600"
                                    Value="120"
                                    TickFrequency="60"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="SpendIntervalSlider_ValueChanged"/>
                            <TextBlock x:Name="SpendIntervalLabel" Grid.Column="1"
                                       Foreground="#EEE" FontSize="13" FontWeight="SemiBold"
                                       Width="80" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock Text="How often to fetch spend data from LiteLLM (independent of usage polling)"
                                   Foreground="#777" FontSize="10.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button Content="Save" Padding="20,7" Margin="0,0,8,0"
                    Click="Save_Click" IsDefault="True"
                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                    FontSize="12" Cursor="Hand"/>
            <Button Content="Cancel" Padding="20,7"
                    Click="Cancel_Click" IsCancel="True"
                    Background="#333" Foreground="#CCC" BorderBrush="#555"
                    FontSize="12" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
