<Window x:Class="ClaudeUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="330" Height="120"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <DropShadowEffect x:Key="BarTextShadow" BlurRadius="3" ShadowDepth="1"
                          Opacity="0.8" Color="Black"/>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on Top"
                      IsCheckable="True" IsChecked="True" Click="AlwaysOnTop_Click"/>
            <MenuItem x:Name="ShowResetTimersMenuItem" Header="Show Reset Timers"
                      IsCheckable="True" IsChecked="True" Click="ShowResetTimers_Click"/>
            <MenuItem x:Name="PausePollingMenuItem" Header="Pause Polling"
                      IsCheckable="True" Click="PausePolling_Click"/>
            <Separator/>
            <MenuItem Header="Settings..." Click="Settings_Click"/>
            <MenuItem Header="Refresh Now" Click="Refresh_Click"/>
            <MenuItem Header="Minimize to Tray" Click="MinimizeToTray_Click"/>
            <MenuItem Header="View Log" Click="ViewLog_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="OuterBorder" Background="#E6181818" CornerRadius="8"
            BorderBrush="#40FFFFFF" BorderThickness="1"
            Width="220" Height="80"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
            MouseEnter="OuterBorder_MouseEnter" MouseLeave="OuterBorder_MouseLeave"
            MouseMove="OuterBorder_MouseMove">
        <Border.RenderTransform>
            <ScaleTransform x:Name="BorderScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Opacity="0.4" ShadowDepth="2" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid x:Name="ContentGrid" Margin="10,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition x:Name="FiveHourTimerRow" Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition x:Name="SevenDayTimerRow" Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 5-Hour Usage Meter -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="5-Hour" Foreground="#999" FontSize="9.5"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="3.5"
                            Height="15" ClipToBounds="True"
                            x:Name="FiveHourTrack"
                            ToolTip="5-Hour: No data">
                        <Grid>
                            <!-- Delta layer (bright) — behind -->
                            <Border x:Name="FiveHourDeltaFill" Background="#81C784"
                                    HorizontalAlignment="Left" Width="0"/>
                            <!-- Base layer (normal color) — on top, covers non-delta -->
                            <Border x:Name="FiveHourFill" Background="#4CAF50"
                                    HorizontalAlignment="Left" Width="0"/>
                            <!-- Percentage / countdown text overlay -->
                            <TextBlock x:Name="FiveHourBarText" Text=""
                                       Foreground="White" FontSize="9" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Effect="{StaticResource BarTextShadow}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5-Hour Reset Timer -->
                <Grid Grid.Row="2" x:Name="FiveHourTimerPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="#1A1A1A" CornerRadius="3"
                            Height="12" ClipToBounds="True"
                            x:Name="FiveHourTimerTrack"
                            ToolTip="5-Hour reset timer">
                        <Grid>
                            <Border x:Name="FiveHourTimerFill" Background="#CC3333"
                                    CornerRadius="3" HorizontalAlignment="Left"
                                    Width="0" Opacity="0.85"/>
                            <TextBlock x:Name="FiveHourTimerText" Text=""
                                       Foreground="#CCFFFFFF" FontSize="9.5" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Effect="{StaticResource BarTextShadow}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 7-Day Usage Meter -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="7-Day" Foreground="#999" FontSize="9.5"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="3.5"
                            Height="15" ClipToBounds="True"
                            x:Name="SevenDayTrack"
                            ToolTip="7-Day: No data">
                        <Grid>
                            <!-- Delta layer (bright) — behind -->
                            <Border x:Name="SevenDayDeltaFill" Background="#64B5F6"
                                    HorizontalAlignment="Left" Width="0"/>
                            <!-- Base layer (normal color) — on top, covers non-delta -->
                            <Border x:Name="SevenDayFill" Background="#2196F3"
                                    HorizontalAlignment="Left" Width="0"/>
                            <!-- Percentage / countdown text overlay -->
                            <TextBlock x:Name="SevenDayBarText" Text=""
                                       Foreground="White" FontSize="9" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Effect="{StaticResource BarTextShadow}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 7-Day Reset Timer -->
                <Grid Grid.Row="6" x:Name="SevenDayTimerPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="#1A1A1A" CornerRadius="3"
                            Height="12" ClipToBounds="True"
                            x:Name="SevenDayTimerTrack"
                            ToolTip="7-Day reset timer">
                        <Grid>
                            <Border x:Name="SevenDayTimerFill" Background="#CC3333"
                                    CornerRadius="3" HorizontalAlignment="Left"
                                    Width="0" Opacity="0.85"/>
                            <TextBlock x:Name="SevenDayTimerText" Text=""
                                       Foreground="#CCFFFFFF" FontSize="9.5" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Effect="{StaticResource BarTextShadow}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status text for no-credentials / errors -->
            <TextBlock x:Name="StatusText" Visibility="Collapsed"
                       Foreground="#80FFFFFF" FontSize="10" FontFamily="Segoe UI"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" TextAlignment="Center"/>

            <!-- Paused dim overlay (renders on top of content) -->
            <Border x:Name="PausedOverlay" Background="#60000000" CornerRadius="8"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="PausedOverlayText"
                           Foreground="White" FontSize="9" FontFamily="Segoe UI" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Visibility="Collapsed"
                           Effect="{StaticResource BarTextShadow}"/>
            </Border>
        </Grid>
    </Border>
</Window>
