<Application x:Class="ClaudeUsageMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark theme colors -->
        <SolidColorBrush x:Key="BgDark" Color="#181818"/>
        <SolidColorBrush x:Key="BgMedium" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BorderDark" Color="#333333"/>
        <SolidColorBrush x:Key="TextDim" Color="#999999"/>
        <SolidColorBrush x:Key="TextLight" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="GreenAccent" Color="#4CAF50"/>
        <SolidColorBrush x:Key="BlueAccent" Color="#2196F3"/>
        <SolidColorBrush x:Key="OrangeAccent" Color="#FF9800"/>
        <SolidColorBrush x:Key="RedAccent" Color="#F44336"/>
    </Application.Resources>
</Application>
